<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permessi: solo quelli che servono. INTERNET: la WebView per la pagina locale e PairWood per parlare con i
         dispositivi abbinati nella Wi-Fi; la parte nativa per controllare gli aggiornamenti su GitHub. La regola di sicurezza (CSP) della pagina blocca ogni connessione dalla pagina. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- impronta o PIN del telefono per aprire l'app e per le operazioni delicate (copie di sicurezza, cancellazione) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- vibrazione dei tocchi -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- avvisi sulle scadenze (Android 13+ li chiede al primo uso) e riprogrammazione dopo il riavvio del telefono -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- la fotocamera serve per inquadrare il QR di abbinamento e per fotografare le fatture; l'app va anche senza -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- «Ho parcheggiato qui»: la posizione si legge solo quando la chiedi tu -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- aggiornamenti da GitHub (fuori dal Play Store): Android chiede sempre la conferma prima di installare -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 11+: per «Scatta foto» l'app deve poter vedere l'app fotocamera di sistema -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- scorciatoie dell'icona: rifornimento, km, intervento -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

        </activity>

        <!-- promemoria delle scadenze: scattano all'ora giusta anche con l'app chiusa -->
        <receiver android:name=".PromemoriaReceiver" android:exported="false" />
        <receiver android:name=".AzioneReceiver" android:exported="false" />
        <!-- widget della Home di Android -->
        <receiver android:name=".DoctorCarWidget" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_doctorcar_info" />
        </receiver>
        <receiver android:name=".DoctorCarWidgetCompatto" android:exported="true" android:label="DoctorCar (compatto)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_doctorcar_compatto_info" />
        </receiver>
        <receiver android:name=".AvvioReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- file della foto appena scattata (la usa Capacitor per «Scatta foto») -->
        <!-- la fotocamera dell'app (CameraX) -->
        <activity
            android:name=".FotocameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PairWood porta con sé il ritorno dall'accesso a Google (serve ad altre app): qui non si usa, si toglie -->
        <activity android:name="pairwood.sdk.RitornoGoogleActivity" tools:node="remove" />
    </application>
</manifest>
