<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
    android:background="@drawable/widget_sfondo">
    <LinearLayout android:id="@+id/w_testi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
        <TextView android:id="@+id/w_riga1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="DoctorCar" android:textColor="#F1F5F9" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_riga2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tocca per aprire" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/w_rifornimento" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
        android:src="@drawable/ic_sc_pompa" android:tint="#0F172A" android:contentDescription="Rifornimento" android:background="@drawable/widget_tasto" android:layout_marginStart="6dp" />
    <ImageView android:id="@+id/w_km" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
        android:src="@drawable/ic_sc_km" android:tint="#0F172A" android:contentDescription="Km" android:background="@drawable/widget_tasto" android:layout_marginStart="6dp" />
    <ImageView android:id="@+id/w_intervento" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
        android:src="@drawable/ic_sc_chiave" android:tint="#0F172A" android:contentDescription="Intervento" android:background="@drawable/widget_tasto" android:layout_marginStart="6dp" />
</LinearLayout>
