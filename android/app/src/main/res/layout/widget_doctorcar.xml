<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_sfondo">
    <LinearLayout android:id="@+id/w_testi" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DoctorCar"
            android:textColor="#F59E0B" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_intest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:text="" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="8dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#334155" android:layout_marginTop="6dp" android:layout_marginBottom="2dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_vuoto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp"
            android:text="Tocca per aprire" android:textColor="#CBD5E1" android:textSize="13sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/w_a1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/w_a1_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#10B981" android:textSize="10sp" android:paddingEnd="8dp" />
            <TextView android:id="@+id/w_a1_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#F1F5F9" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_a1_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:paddingStart="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_a2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
